@model IEnumerable<Product>

<section class="product-area li-laptop-product pt-45 pb-45">
    <div class="container">
        <div class="row">
            <!-- Begin Li's Section Area -->
            <div class="col-lg-12">
                <div class="li-section-title">
                    <h2>
                        <span>@ViewBag.SearchTerm  |( @ViewBag.TotalResults item )</span>
                    </h2>
                    
                </div>
               
                <div class="row pt-30">
                    @if (!Model.Any())
                    {
                        <div class="alert alert-warning">Sorry, we did not find any product that matches your search</div>
                    }else
                    {
                        
                        @foreach (var product in Model)
                        {
                            <div class="col-lg-3 col-md-4 col-sm-6 mb-40">
                        
                                <div class="col-lg-12">
                            
                                    <!-- single-product-wrap start -->
                                    <div class="single-product-wrap">
                                        <div class="product-image">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                                <img src="~/@product.Img" style="border-radius:10px" alt="Li's GiftBoxes Image">
                                            </a>
                                            <span class="sticker">New</span>
                                        </div>
                                        <div class="product_desc">
                                            <div class="product_desc_info">
                                                <div class="product-review">
                                                    <h5 class="manufacturer">
                                                        <a href="shop-left-sidebar.html">@product.Category.Name</a>
                                                    </h5>
                                               
                                                </div>
                                                <h4><a class="product_name" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a></h4>
                                                <div class="price-box">
                                                    <span class="new-price">EGP @product.Price</span>
                                                </div>
                                            </div>
                                            <div class="add-actions">
                                                <ul class="add-actions-link">
                                                    <li class="add-cart active"><a href="javascript:void(0);" onclick="addToCart(@product.Id)">Add to cart</a></li>
                                                    <li><a class="links-details" href="single-product.html"><i class="fa fa-heart-o"></i></a></li>
                                                    <li><a class="quick-view" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"><i class="fa fa-eye"></i></a></li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- single-product-wrap end -->
                            
                                </div>

                            </div>
                        }


                    }
                   
                </div>
                    
            </div>
        </div>
        <!-- Li's Section Area End Here -->
    </div>
</div>
</section>