<!doctype html>
<html class="no-js" lang="zxx">
    
<!-- index-331:38-->
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@ViewData["Title"] - Tasneem_Shop.Web</title>
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="images/favicon.png">
    <!-- Material Design Iconic Font-V2.2.0 -->
    <link rel="stylesheet" href="~/Customer/css/material-design-iconic-font.min.css">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/Customer/css/font-awesome.min.css">
    <!-- Font Awesome Stars-->
    <link rel="stylesheet" href="~/Customer/css/fontawesome-stars.css">
    <!-- Meanmenu CSS -->
    <link rel="stylesheet" href="~/Customer/css/meanmenu.css">
    <!-- owl carousel CSS -->
    <link rel="stylesheet" href="~/Customer/css/owl.carousel.min.css">
    <!-- Slick Carousel CSS -->
    <link rel="stylesheet" href="~/Customer/css/slick.css">
    <!-- Animate CSS -->
    <link rel="stylesheet" href="~/Customer/css/animate.css">
    <!-- Jquery-ui CSS -->
    <link rel="stylesheet" href="~/Customer/css/jquery-ui.min.css">
    <!-- Venobox CSS -->
    <link rel="stylesheet" href="~/Customer/css/venobox.css">
    <!-- Nice Select CSS -->
    <link rel="stylesheet" href="~/Customer/css/nice-select.css">
    <!-- Magnific Popup CSS -->
    <link rel="stylesheet" href="~/Customer/css/magnific-popup.css">
    <!-- Bootstrap V4.1.3 Fremwork CSS -->
    <link rel="stylesheet" href="~/Customer/css/bootstrap.min.css">
    <!-- Helper CSS -->
    <link rel="stylesheet" href="~/Customer/css/helper.css">
    <!-- Main Style CSS -->
    <link rel="stylesheet" href="~/Customer/style.css">
    <!-- Responsive CSS -->
    <link rel="stylesheet" href="~/Customer/css/responsive.css">
    <!-- Modernizr js -->
    <script src="~/Customer/js/vendor/modernizr-2.8.3.min.js"></script>
</head>
<body>
    <!--[if lt IE 8]>
		<p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="http://browsehappy.com/">upgrade your browser</a> to improve your experience.</p>
	<![endif]-->
    <!-- Begin Body Wrapper -->
    <div class="body-wrapper">
        
        <!-- Begin Header Area -->
        <header>
            <!-- Begin Header Top Area -->
            <div class="header-top">
                <div class="container">
                    <div class="row">
                        <!-- Begin Header Top Left Area -->
                        <div class="col-lg-3 col-md-4">
                            
                        </div>
                        <!-- Header Top Left Area End Here -->
                        <!-- Begin Header Top Right Area -->
                        <div class="col-lg-9 col-md-8">
                            <div class="header-top-right">
                                <ul class="ht-menu">
                                    <!-- Begin Setting Area -->
                                    <partial name="_LoginPartial"/>
                                   
                      
                                </ul>
                            </div>
                        </div>
                        <!-- Header Top Right Area End Here -->
                    </div>
                </div>
            </div>
            <!-- Header Top Area End Here -->
            <!-- Begin Header Middle Area -->
        <div class="header-middle  pl-sm-0 pr-sm-0 pl-xs-0 pr-xs-0">
                <div class="container">
                    <div class="row">
                        <!-- Begin Header Logo Area -->
                        <div class="col-lg-3">
                            <div class="logo pb-sm-30 pb-xs-30">
                                <a href="">
                                    <img src="~/Customer/images/menu/logo/1.jpg" alt="">
                                </a>
                            </div>
                        </div>
                        <!-- Header Logo Area End Here -->
                        <!-- Begin Header Middle Right Area -->
                        <div class="col-lg-9">
                            <!-- Begin Header Middle Searchbox Area -->
                            <form action="#" class="hm-searchbox">
                                <select class="nice-select select-search-category">
                                    <option value="0">All</option>
                                   
                                </select>
                            <input type="text" placeholder="Looking for something?">
                                <button class="li-btn" type="submit"><i class="fa fa-search"></i></button>
                            </form>
                            <!-- Header Middle Searchbox Area End Here -->
                            <!-- Begin Header Middle Right Area -->
                            <div class="header-middle-right">
                                <ul class="hm-menu">
                                    <!-- Begin Header Middle Wishlist Area -->
                                    <li class="hm-wishlist">
                                        <a href="wishlist.html">
                                            <span class="cart-item-count2 wishlist-item-count">0</span>
                                            <i class="fa fa-heart-o"></i>
                                        </a>
                                    </li>
                                    <!-- Header Middle Wishlist Area End Here -->
                                    <!-- Begin Header Mini Cart Area -->
                                    <li class="hm-minicart">
                                        @await Html.PartialAsync("~/Areas/Customer/Views/Shared/_MinicartPartial.cshtml")
                                    </li>
                                    <!-- Header Mini Cart Area End Here -->
                                </ul>
                            </div>
                            <!-- Header Middle Right Area End Here -->
                        </div>
                        <!-- Header Middle Right Area End Here -->
                    </div>
                </div>
            </div>
            <!-- Header Middle Area End Here -->
            <!-- Begin Header Bottom Area -->
        <div class="header-bottom header-sticky stick d-none d-lg-block d-xl-block">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-12">
                            <!-- Begin Header Bottom Menu Area -->
                            <div class="hb-menu hb-menu-2">
                                <nav>
                                    <ul>
                                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                    <li><a asp-controller="Product" asp-action="Shop">SHOP</a></li>
                                    <li><a asp-controller="Product" asp-action="GetAllHotDeals">Hot Deals</a></li>
                                        <li><a href="">MY ORDERS</a></li>
                                        <!-- Begin Header Bottom Menu Information Area -->
                                        <li class="hb-info f-right p-0 d-sm-none d-lg-block">
                                            <span>Al-Mashaya Al-Olya St, Mansoura, Egypt</span>
                                        </li>
                                        <!-- Header Bottom Menu Information Area End Here -->
                                    </ul>
                                </nav>
                            </div>
                            <!-- Header Bottom Menu Area End Here -->
                        </div>
                    </div>
                </div>
            </div>
            <!-- Header Bottom Area End Here -->
            <!-- Begin Mobile Menu Area -->
            <div class="mobile-menu-area d-lg-none d-xl-none col-12">
                <div class="container">
                    <div class="row">
                        <div class="mobile-menu">
                        </div>
                    </div>
                </div>
            </div>
            <!-- Mobile Menu Area End Here -->
        </header>
        @RenderBody()
        <!-- Li's Trending Product Area End Here -->
        <!-- Begin Footer Area -->
        <div class="footer">
            <!-- Begin Footer Static Top Area -->
            <div class="footer-static-top footer-static-top-3 pt-xs-50 pb-xs-10">
                <div class="container">
                    <!-- Begin Footer Shipping Area -->
                    <div class="footer-shipping pb-xs-0">
                        <div class="row">
                            <!-- Begin Li's Shipping Inner Box Area -->
                            <div class="col-lg-3 col-md-3 col-sm-6 pb-xs-45">
                                <div class="li-shipping-inner-box">
                                    <div class="shipping-icon">
                                        <img src="~/Customer/images/shipping-icon/1.png" style="width:80% ;height:80%" alt="Shipping Icon">
                                    </div>
                                    <div class="shipping-text">
                                    <h2>Gift Delivery</h2>
                                    <p>We deliver your gifts to all regions across Egypt</p>
                                    </div>
                                </div>
                            </div>
                            <!-- Li's Shipping Inner Box Area End Here -->
                            <!-- Begin Li's Shipping Inner Box Area -->
                            <div class="col-lg-3 col-md-3 col-sm-6 pb-xs-45">
                                <div class="li-shipping-inner-box">
                                    <div class="shipping-icon">
                                    <img src="~/Customer/images/shipping-icon/2.png" style="width:80% ;height:80%"  alt="Shipping Icon">
                                    </div>
                                    <div class="shipping-text">
                                        <h2>Safe Payment</h2>
                                        <p>Pay with the world's most popular and secure payment methods.</p>
                                    </div>
                                </div>
                            </div>
                            <!-- Li's Shipping Inner Box Area End Here -->
                            <!-- Begin Li's Shipping Inner Box Area -->
                            <div class="col-lg-3 col-md-3 col-sm-6 pb-xs-45">
                                <div class="li-shipping-inner-box">
                                    <div class="shipping-icon">
                                    <img src="~/Customer/images/shipping-icon/3.png" style="width:75% ;height:90%"  alt="Shipping Icon">
                                    </div>
                                    <div class="shipping-text">
                                    <h2>Quality Assurance</h2>
                                    <p>Shop with confidence for authentic and high-quality products.</p>
                                    </div>
                                </div>
                            </div>
                            <!-- Li's Shipping Inner Box Area End Here -->
                            <!-- Begin Li's Shipping Inner Box Area -->
                            <div class="col-lg-3 col-md-3 col-sm-6">
                                <div class="li-shipping-inner-box last-child">
                                    <div class="shipping-icon">
                                    <img src="~/Customer/images/shipping-icon/4.png" style="width:70% ;height:90%" alt="Shipping Icon">
                                    </div>
                                    <div class="shipping-text">
                                    <h2>Customer Support</h2>
                                    <p>Let us help you find the perfect gift for every occasion.</p>
                                    </div>
                                </div>
                            </div>
                            <!-- Li's Shipping Inner Box Area End Here -->
                        </div>
                    </div>
                    <!-- Footer Shipping Area End Here -->
                </div>
            </div>
            <!-- Footer Static Top Area End Here -->
            <!-- Begin Footer Static Middle Area -->
        <div class="col-lg-12">
            <div class="footer-brand-container" style="text-align: center; padding-top: 40px; padding-bottom: 40px;">
        
                <div class="footer-logo" style="margin-bottom: 15px;">
                    <img src="~/Customer/images/menu/logo/1.jpg" alt="Footer Logo" style="max-height: 50px; display: inline-block;">
                </div>
        
                <div class="footer-copyright-text">
                    <p style="font-size: 14px; color: #666; margin: 0; display: block;">
                        Copyright &copy; @DateTime.Now.Year
                        <a href="#" style="color: #fed700; font-weight: bold; text-decoration: none;">Eng.Mostafa Elshehawy</a>.
                        All rights reserved.
                    </p>
                </div>
        
            </div>
        </div>
            <!-- Footer Static Middle Area End Here -->
            <!-- Begin Footer Static Bottom Area -->
            
            <!-- Footer Static Bottom Area End Here -->
        </div>
        <!-- Footer Area End Here -->
       
    </div>
    <!-- Body Wrapper End Here -->
    <!-- jQuery-V1.12.4 -->
    <script src="~/Customer/js/vendor/jquery-1.12.4.min.js"></script>
    <!-- Popper js -->
    <script src="~/Customer/js/vendor/popper.min.js"></script>
    <!-- Bootstrap V4.1.3 Fremwork js -->
    <script src="~/Customer/js/bootstrap.min.js"></script>
    <!-- Ajax Mail js -->
    <script src="~/Customer/js/ajax-mail.js"></script>
    <!-- Meanmenu js -->
    <script src="~/Customer/js/jquery.meanmenu.min.js"></script>
    <!-- Wow.min js -->
    <script src="~/Customer/js/wow.min.js"></script>
    <!-- Slick Carousel js -->
    <script src="~/Customer/js/slick.min.js"></script>
    <!-- Owl Carousel-2 js -->
    <script src="~/Customer/js/owl.carousel.min.js"></script>
    <!-- Magnific popup js -->
    <script src="~/Customer/js/jquery.magnific-popup.min.js"></script>
    <!-- Isotope js -->
    <script src="~/Customer/js/isotope.pkgd.min.js"></script>
    <!-- Imagesloaded js -->
    <script src="~/Customer/js/imagesloaded.pkgd.min.js"></script>
    <!-- Mixitup js -->
    <script src="~/Customer/js/jquery.mixitup.min.js"></script>
    <!-- Countdown -->
    <script src="~/Customer/js/jquery.countdown.min.js"></script>
    <!-- Counterup -->
    <script src="~/Customer/js/jquery.counterup.min.js"></script>
    <!-- Waypoints -->
    <script src="~/Customer/js/waypoints.min.js"></script>
    <!-- Barrating -->
    <script src="~/Customer/js/jquery.barrating.min.js"></script>
    <!-- Jquery-ui -->
    <script src="~/Customer/js/jquery-ui.min.js"></script>
    <!-- Venobox -->
    <script src="~/Customer/js/venobox.min.js"></script>
    <!-- Nice Select js -->
    <script src="~/Customer/js/jquery.nice-select.min.js"></script>
    <!-- ScrollUp js -->
    <script src="~/Customer/js/scrollUp.min.js"></script>
    <!-- Main/Activator js -->
    <script src="~/Customer/js/main.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

