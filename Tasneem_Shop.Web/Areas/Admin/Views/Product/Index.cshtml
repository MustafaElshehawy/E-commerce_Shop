@model IEnumerable<Product>

@{
    ViewBag.PageTitle = "Product Management";
    ViewBag.CardTitle = "All Product";
}
<link rel="stylesheet" href="~/css/category.css" />

 
<a asp-action="Create" asp-controller="Product" class="btn btn-outline-primary">create Product</a>
<table class="custom-table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Img</th>
            <th>Price</th>
            <th>CategoryId</th>
            <th>IsHotDeal</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                
                <td>
                    <div class="text-truncate-custom">
                        @item.Name
                    </div>
                </td>
                <td>
                    <div class="text-truncate-custom">
                        @item.Description
                    </div>
                </td>
                <td>
                    <div class="text-truncate-custom">
                        @item.Img
                    </div>
                </td>
                <td>@item.Price</td>
                <td>@item.CategoryId</td>
                <td>@item.IsHotDeal</td>
                <td>
                    <a asp-action="Edit" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-primary"><i class="nav-icon 	fas fa-pen"></i></a>
                    <a asp-action="Offer" asp-controller="Offers" asp-route-id="@item.Id" class="btn btn-dark"><i class="nav-icon 	fas fa-tags"></i></a>
                    <a asp-action="Delete" asp-controller="Product" asp-route-id="@item.Id" class="btn btn-danger"><i class="nav-icon 	fas fa-trash"></i></a>
                    


                </td>
            </tr>
        }
    </tbody>
</table>