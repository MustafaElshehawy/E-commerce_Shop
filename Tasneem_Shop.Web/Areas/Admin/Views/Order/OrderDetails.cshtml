@model OrderVM
@using Utilities

<form method="post" class="py-3">
    <input hidden asp-for="OrderHeader.Id" />
    <div class="container-fluid px-4">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold text-dark m-0">Order ID: #@Model.OrderHeader.Id</h3>
                <p class="text-muted small m-0">Placed: @Model.OrderHeader.OrderDate.ToString("MMMM dd, yyyy")</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-4">Back to Orders</a>
        </div>

        <div class="row g-4">
            <div class="col-12 col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4" >
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Full Name</label>
                                <input asp-for="OrderHeader.Name" class="form-control bg-light border-0" />
                                <span asp-validation-for="OrderHeader.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Phone Number</label>
                                <input asp-for="OrderHeader.Phone" class="form-control bg-light border-0" />
                                <span asp-validation-for="OrderHeader.Phone" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label class="small fw-bold text-muted mb-1">Shipping Address</label>
                                <input asp-for="OrderHeader.Address" class="form-control bg-light border-0" />
                                <span asp-validation-for="OrderHeader.Address" class="text-danger"></span>

                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">City</label>
                                <input asp-for="OrderHeader.City" class="form-control bg-light border-0" />
                                <span asp-validation-for="OrderHeader.City" class="text-danger"></span>

                            </div>
                            <div class="col-md-6">
                                <label class="small fw-bold text-muted mb-1">Shipping Date</label>
                                <input value="@Model.OrderHeader.ShippingDate.ToShortDateString()" readonly type="text"class="form-control" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-3">
                        <div class="row g-2 align-items-center">
                            <div class="col-md-5">
                                <input asp-for="OrderHeader.Carrier" id="carrier" class="form-control form-control-sm" placeholder="Carrier Name" />
                            </div>
                            <div class="col-md-5">
                                <input asp-for="OrderHeader.TrackingNumber" id="trackingNumber" class="form-control form-control-sm" placeholder="Tracking Number" />
                            </div>
                            <div class="col-md-2">
                                <button type="submit" asp-action="UpdateOrderDetails" class="btn btn-primary btn-sm w-100">UPDATE</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5">
                
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-3 d-flex justify-content-between align-items-center">
                        <span class="badge rounded-pill bg-dark bg-opacity-10 text-info px-4 py-2 fw-bold text-uppercase" style="font-size: 0.7rem;">
                            Order Status: @Model.OrderHeader.OrderStatus
                        </span>
                        <div class="text-end">
                            <h6 class="small text-muted m-0">Payment Status: <span class="fw-bold text-outline-success">@Model.OrderHeader.PaymentStatus</span></h6>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">Order Items</h5>
                        @foreach (var detail in Model.OrderDetails)
                        {
                            <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light rounded-2 p-2 me-3">
                                        <img src="~/@detail.Product.Img" style="max-height:50px ;max-width:50px ;border-radius:4px" alt="Li's Product Image">
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold small">@detail.Product.Name</h6>
                                        <p class="text-muted small mb-0">@detail.Price.ToString("N0") x @detail.Count</p>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark">@((detail.Count * detail.Price).ToString("N2"))</span>
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center mt-4">
                            <span class="h6 fw-bold text-muted m-0">Total Amount</span>
                            <span class="h4 fw-bold text-primary m-0">@Model.OrderHeader.TotalPrice.ToString("N2") <small class="fs-6">EGP</small></span>
                        </div>
                    </div>
                </div>
                <div class="card border-0 shadow-sm rounded-4 mb-3">
                    <div class="card-body p-3">
                        <div class="d-flex gap-2">
                            @if (Model.OrderHeader.OrderStatus == SD.Approve)
                            {
                                <button type="submit" asp-action="StartProcessing" class="btn btn-warning flex-fill fw-bold btn-sm py-2 mr-2">
                                    START PROCESSING
                                </button>
                            }
                            @if (Model.OrderHeader.OrderStatus == SD.Proccessing)
                            {
                                <button type="submit" asp-action="StartShiping" class="btn btn-primary flex-fill fw-bold btn-sm py-2 mr-2">
                                    START SHIPING
                                </button>
                            }
                            @if (Model.OrderHeader.OrderStatus != "SD.Cancelled" || Model.OrderHeader.OrderStatus != SD.Refund)
                            {
                                <button type="submit" asp-action="CancelOrder" class="btn btn-danger flex-fill fw-bold btn-sm py-2 mr-2">
                                    CANCEL ORDER
                                </button>
                            }
                            
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>