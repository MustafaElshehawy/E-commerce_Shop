@model UserVM
@{
    ViewBag.PageTitle = "User Management";
    ViewBag.CardTitle = "Add New User";
}

<form asp-action="Create" method="post">
         
    <div class="form-group">
        <label asp-for="User.Name"></label>
        <input asp-for="User.Name" class="form-control" aria-required="true" />
        <span asp-validation-for="User.Name" class="text-danger"></span>
    </div><div class="form-group">
    <label asp-for="User.Address"></label>
    <input asp-for="User.Address" class="form-control" aria-required="true" />
    <span asp-validation-for="User.Address" class="text-danger"></span>
</div><div class="form-group">
<label asp-for="User.City"></label>
<input asp-for="User.City" class="form-control" aria-required="true" />
<span asp-validation-for="User.City" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="User.Email"></label>
    <input asp-for="User.Email" class="form-control" autocomplete="username" aria-required="true" />
    <span asp-validation-for="User.Email" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Password"></label>
    <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="true" />
    <span asp-validation-for="Password" class="text-danger"></span>
</div>
<div class="form-group ">
    <label asp-for="ConfirmPassword"></label>
    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
</div>
<div class="mb-3">
    <label class="form-label fw-bold">Assign Role</label>
    <select asp-for="Role" class="custom-select" asp-items="Model.RoleList">
        <option disabled selected>-- Select Role --</option>
    </select>
</div>
</br>
<div asp-validation-summary="All" class="text-danger"></div>
<div class="form-group ">
    <button type="submit" class="btn btn-primary  w-100 py-2   shadow-sm">Register</button>
</div>
</form>
